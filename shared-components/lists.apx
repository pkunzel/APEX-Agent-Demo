list navigation-bar (
    name: Navigation Bar

    entry action-a-pwa-install (
        label: Install App
        icon {
            imageIconCssClasses: fa-cloud-download
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: #action$a-pwa-install
            }
        }
        userDefinedAttributes {
            2: a-pwaInstall
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry settings (
        label: Settings
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 1
            parentEntry: @app-user
        }
        link {
            target: {
                page: 20000
            }
        }
        config {
            buildOption: @feature-user-settings
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 40
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry agent-with-1-tool (
        label: Agent with 1 Tool
        icon {
            imageIconCssClasses: fa-chatbot
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 3
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry agent-with-client-and-server-siide (
        label: Agent with Client and Server Siide
        icon {
            imageIconCssClasses: fa-robot
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 4
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry apex-access-controlled-agent (
        label: APEX access controlled agent
        icon {
            imageIconCssClasses: fa-ai-microchip
        }
        layout {
            sequence: 60
        }
        isCurrent {
            type: pages
            pages: 6
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry multi-agent-process (
        label: Multi Agent Process
        icon {
            imageIconCssClasses: fa-ai
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: 5
        }
        link {
            target: {
                page: 5
            }
        }
        config {
            buildOption: @commented-out
        }
    )

    entry system-augmented-prompt (
        label: System Augmented Prompt
        icon {
            imageIconCssClasses: fa-terminal
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 2
        }
        link {
            target: {
                page: 2
            }
        }
    )

)

list user-settings (
    name: User Settings
    config {
        buildOption: @feature-user-settings
    }

    entry push-notifications (
        label: Push Notifications
        icon {
            imageIconCssClasses: fa-bell-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 20010
            }
        }
        userDefinedAttributes {
            1: Configure whether you want to receive push notifications on this device.
            2: <span class="a-pwaPush--state"></span>
        }
        config {
            buildOption: @feature-push-notifications
        }
    )

)

