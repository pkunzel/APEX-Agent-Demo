aiAgent weather-forecast-agent (
    name: 3 - Weather Forecast Agent
    genAI {
        systemPrompt:
            ```
            # Role
            You are a weather forecast assistant
            
            # Instructions
            Once run, obtain the user's location
            After getting the user's location, access the weather API tool to make a weather forecast
            
            # Guidelines
            reply in english.
            Be concise
            ```
    }

    tool get-geo-location (
        name: get_user_location
        type: executeClientsideCode
        executionPoint: onDemand
        description: Returns the users location coordinates like latitude and longitude.
        settings {
            jsCode:
                ```javascript-browser
                const getGeoLocation = () =>
                  new Promise((resolve, reject) =>
                    navigator.geolocation.getCurrentPosition(resolve, reject)
                  );
                
                const geoLocation = await getGeoLocation();
                
                const geoLocationString = JSON.stringify({
                  latitude: geoLocation.coords.latitude,
                  longitude: geoLocation.coords.longitude,
                  accuracy: geoLocation.coords.accuracy
                });
                
                apex.item("P4_COORDINATES").setValue(geoLocationString);
                
                return geoLocationString;
                ```
        }
    )

    tool get-weather-api (
        name: get_weather_api
        type: executeServersideCode
        executionPoint: onDemand
        description: Based on the Latitude and Longitude provided, gets the weather forecast from an API call. Only call this after getting the coordinates
        settings {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                    l_response clob;
                begin
                    l_response := apex_web_service.make_rest_request(
                        p_url         => 'https://api.open-meteo.com/v1/forecast?latitude='|| :LATITUDE ||'&longitude=' || :LONGITUDE || '&daily=temperature_2m_mean',
                        p_http_method => 'GET'
                    );
                
                    apex_ai.set_tool_result (p_result => l_response);
                end;
                ```
        }

        parameter LATITUDE (
            description: the Latitude provided by context
        )

        parameter LONGITUDE (
            description: The longitude provided by context
        )

    )

)

