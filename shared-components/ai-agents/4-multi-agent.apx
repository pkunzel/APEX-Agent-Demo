aiAgent 4-multi-agent (
    name: 4 - Multi agent
    genAI {
        systemPrompt: You're a chabot that will help bring customer, product and sales data;
    }

    tool get-customer-data (
        name: get_customer_data
        type: executeServersideCode
        executionPoint: onDemand
        description: gets the data for a given customer based on their name
        settings {
            language: plsql
            plsqlCode:
                ```plsql
                DECLARE
                    l_response clob;
                BEGIN
                    l_response :=
                        apex_ai.generate (
                            p_prompt            => :CUSTOMER_NAME,
                            p_agent_static_id   => '4-1-sub-agent-customer' );
                
                    apex_ai.set_tool_result (
                         p_result                => l_response,
                         p_notification_message  => 'called sub agent to retrieve customers',
                         p_notification_type     => apex_ai.c_response_type_tool_calls);
                END;
                ```
        }

        parameter CUSTOMER_NAME (
            description: The name of the customer
        )

    )

)

