page 1 (
    name: Home
    alias: HOME
    title: Full Agent App
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region full-agent-app (
        name: Full Agent App
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    button get-weather-forecast (
        buttonName: GET_WEATHER_FORECAST
        label: Get Weather Forecast
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-open-ai-assistant (
            action: showAiAssistant
            genAI {
                agent: @weather-forecast-agent
            }
            execution {
                sequence: 10
            }
        )

    )

)

