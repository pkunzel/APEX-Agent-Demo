page 6 (
    name: APEX access controlled agent
    alias: APEX-ACCESS-CONTROLLED-AGENT
    title: APEX access controlled agent
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region conversation (
        name: Conversation
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: region-chabot
        }
    )

    button new (
        buttonName: CHATBOT
        label: Chatbot
        layout {
            sequence: 10
            region: @conversation
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
            icon: fa-chatbot
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: Open Chatbot
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @new
        }

        action native-open-ai-assistant (
            action: showAiAssistant
            genAI {
                agent: @apex-controlled-agent
            }
            appearance {
                displayAs: inline
                containerSelector: #region-chabot
            }
            execution {
                sequence: 10
            }
            advanced {
                initJavaScriptFunction:
                    ```javascript-browser
                     function( options ) {
                        window.chatModel?.destroy()
                        window.chatView?.destroy()
                        
                        options.useChatContext = ( chatModel, chatView ) => {
                            window.chatModel = chatModel;
                            window.chatView = chatView;
                        };
                    
                        return options;
                    }
                    ```
            }
        )

    )

)

