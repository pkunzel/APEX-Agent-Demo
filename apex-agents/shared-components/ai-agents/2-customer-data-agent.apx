aiAgent 2-customer-data-agent (
    name: 2 - Customer Data Agent
    genAI {
        systemPrompt:
            ```
            # Role
            You are an useful assistant who provides customer data to the user based on information passed by tools
            
            # Goals
            - The user will ask some information about a customer and you should get the information to provide him with a reply
            - You will use the tools to get the information for 1 or multiple customers and retrieve it to the user.
            
            # Restriction
            - Do not add information that wasn't provided through context and function calling.
            - review the information
            - If there is an issue, reply with information about the issue
            
            # Reply rules
            - if possible, reply in a tabular format
            - All replies must be in english
            
            ```
        welcomeMessage: Hello, how can I assist you?
    }

    tool get-customer-data (
        name: get_customer_data
        type: retrieveData
        executionPoint: onDemand
        description: Retrieves the data from a given based on the customer Code that must be provided to make the search
        settings {
            dataDescription: The customer data as currently available in the database
            sqlQuery:
                ```sql
                select *
                from AGENT_CUSTOMERS
                where ID = :CUSTOMER_ID
                ```
        }

        parameter CUSTOMER_ID (
            description: The code that uniquely references the customer
            value {
                dataType: number
            }
        )

    )

)

